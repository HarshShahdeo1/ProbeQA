# =============================================================================
# ProbeQA — Root Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
#   1. Copy this file to '.env' before starting Docker Compose:
#        cp .env.example .env
#   2. Fill in a strong GF_SECURITY_ADMIN_PASSWORD below.
#   3. Never commit your real '.env' file to version control.
# =============================================================================

# ── Grafana Observability Credentials (REQUIRED FOR DOCKER COMPOSE) ──────────
GF_SECURITY_ADMIN_USER=admin
# Specify a strong administrator password. Do NOT commit real passwords to Git.
GF_SECURITY_ADMIN_PASSWORD=your_strong_grafana_password_here

# ── Docker Compose Published Port Overrides (Optional) ───────────────────────
# Defaults are selected to avoid collisions with local host services:
BACKEND_PORT=8001
FRONTEND_PORT=5174
PROMETHEUS_PORT=9091
GRAFANA_PORT=3002

# ── Optional AI Provider Credentials for Containerized Backend ───────────────
# If left blank, the backend operates in deterministic rule-based fallback mode.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Frontend Development (Vite) ──────────────────────────────────────────────
VITE_API_BASE_URL=http://127.0.0.1:8000
