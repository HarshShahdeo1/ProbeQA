# .env.example — copy this to .env and fill in real values
# .env is listed in .gitignore and must NEVER be committed to version control.

# Active provider: "groq" or "gemini"
LLM_PROVIDER=groq

# Groq API configuration (Stage 4 AI Planner)
# Obtain an API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Google Gemini API configuration (Stage 4 AI Planner)
# Obtain an API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Reserved for future database connection.
DATABASE_URL=
